# Copy this file to .env and fill in your Supabase project's URL and anon
# (public) key: Supabase dashboard -> Project settings -> API. These are
# safe to expose in the client bundle — access is enforced by Row Level
# Security policies (supabase/migrations/0001_init.sql), not by hiding these
# values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
